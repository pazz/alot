############################################################################
#                               Default Theme                              #
#                                                                          #
# for alot. © 2012 Patrick Totzke, GNU GPL3+, https://github.com/pazz/alot #
#                                                                          #
# Follows the terminal's palette and background, dark or light.            #
############################################################################

[global]
    footer = 'standout','','standout','default','g93','g27'
    body = 'default','','default','default','default','default'
    notify_error = 'standout','','white,bold','dark red','white,bold','#a00'
    notify_normal = 'standout','','standout','default','g93','g27'
    prompt = 'default','','default','default','default','default'
    tag = 'default','','dark cyan','default','#088','default'
    tag_focus = 'standout','','dark cyan,standout','default','white','#06a'
[help]
    text = 'default','','default','default','default','default'
    section = 'bold','','bold','default','bold','default'
    title = 'standout','','standout,bold','default','white,bold','#06a'
[bufferlist]
    line_focus = 'standout','','standout','default','white','#06a'
    line_even = 'default','','default','default','default','default'
    line_odd = 'default','','default','default','default','default'
[taglist]
    line_focus = 'standout','','standout','default','white','#06a'
    line_even = 'default','','default','default','default','default'
    line_odd = 'default','','default','default','default','default'
[namedqueries]
    line_focus = 'standout','','standout','default','white','#06a'
    line_even = 'default','','default','default','default','default'
    line_odd = 'default','','default','default','default','default'
[thread]
    arrow_heads = 'default','','default','default','#d60','default'
    arrow_bars = 'default','','default','default','#a60','default'
    attachment = 'default','','dark magenta','default','#a6a','default'
    attachment_focus = 'standout','','dark magenta,standout','default','white','#06a'
    body = 'default','','default','default','default','default'
    body_focus = 'standout','','standout','default','white','#06a'
    header = 'default','','default','default','default','default'
    header_key = 'bold','','bold','default','g50,bold','default'
    header_value = 'default','','default','default','default','default'

    [[summary]]
        even = 'bold','','bold','default','g93,bold','g27'
        odd = 'bold','','bold','default','g93,bold','g27'
        focus = 'standout','','standout','default','white','#06a'

[envelope]
    body = 'default','','default','default','default','default'
    header = 'default','','default','default','default','default'
    header_key = 'bold','','bold','default','g50,bold','default'
    header_value = 'default','','default','default','default','default'
[search]
    [[threadline]]
        normal = 'default','','default','default','default','default'
        focus = 'standout','','standout','default','white','#06a'
        parts = date,mailcount,tags,authors,subject
        [[[date]]]
            normal = 'default','','default','default','g50','default'
            focus = 'standout','','standout','default','g85','#06a'
            width = 'fit',10,10
            alignment = right
        [[[mailcount]]]
            normal = 'default','','default','default','g50','default'
            focus = 'standout','','standout','default','g85','#06a'
            width = 'fit', 5,5
        [[[tags]]]
            normal = 'default','','dark cyan','default','#088','default'
            focus = 'standout','','standout','default','#8ff','#06a'
        [[[authors]]]
            normal = 'default','','light blue','default','#66d','default'
            focus = 'standout','','standout','default','white,bold','#06a'
            width = 'fit',0,30
        [[[subject]]]
            normal = 'default','','default','default','default','default'
            focus = 'standout','','standout','default','white','#06a'
            width = 'weight', 1
        [[[content]]]
            normal = 'default','','default','default','g50','default'
            focus = 'standout','','standout','default','g85','#06a'
            width = 'weight', 1

    # threads with unread messages
    [[threadline-unread]]
        tagged_with = 'unread'
        normal = 'bold','','default,bold','default','default,bold','default'
        parts = date,mailcount,tags,authors,subject
        [[[date]]]
            normal = 'bold','','default,bold','default','g50,bold','default'
        [[[mailcount]]]
            normal = 'bold','','default,bold','default','g50,bold','default'
        [[[tags]]]
            normal = 'bold','','dark cyan,bold','default','#088,bold','default'
        [[[authors]]]
            normal = 'bold','','light blue,bold','default','#66d,bold','default'
        [[[subject]]]
            normal = 'bold','','default,bold','default','default,bold','default'
        [[[content]]]
            normal = 'default','','default','default','g50','default'
